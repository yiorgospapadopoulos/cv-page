import Footer from '../components/Footer.astro';
import MoreDialog from '../components/MoreDialog.astro';
import { profile } from '../content/profile';
---

<Base title={profile.meta.title} description={profile.meta.description}>
  <main>
    <Hero />
    <Terminals />
  </main>
  <Footer />
  <MoreDialog />
</Base>
