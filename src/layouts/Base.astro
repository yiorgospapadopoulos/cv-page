---
import fraunces from '@fontsource-variable/fraunces/files/fraunces-latin-opsz-normal.woff2?url';
import jetbrainsMono from '@fontsource-variable/jetbrains-mono/files/jetbrains-mono-latin-wght-normal.woff2?url';
import '../styles/tokens.css';
import '../styles/global.css';
import { badgeHeadScript } from '../lib/badge/entrance';
import { fontFaceCss } from '../lib/fonts';
import { skipLink } from '../lib/site';

interface Props {
  title: string;
  description: string;
  image?: string;
}

const { title, description, image = '/og.png' } = Astro.props;
const fontCss = fontFaceCss([
  { family: 'Fraunces Variable', url: fraunces, weight: '100 900' },
  { family: 'JetBrains Mono Variable', url: jetbrainsMono, weight: '100 800' },
]);
const imageUrl =
  Astro.site === undefined ? image : new URL(image, Astro.site).href;
const pageUrl =
  Astro.site === undefined
    ? undefined
    : new URL(Astro.url.pathname, Astro.site).href;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link
      rel="preload"
      href={fraunces}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <style is:inline set:html={fontCss}></style>
    {pageUrl && <link rel="canonical" href={pageUrl} />}
    <meta property="og:type" content="website" />
    {pageUrl && <meta property="og:url" content={pageUrl} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <script is:inline>
      if (
        !matchMedia('(prefers-reduced-motion: reduce)').matches &&
        'IntersectionObserver' in window
      ) {
        const root = document.documentElement;
        root.classList.add('typing');
        setTimeout(() => {
          if (root.dataset.typing === 'on') return;
          root.classList.remove('typing');
          root.dataset.typing = 'off';
        }, 3000);
      }
    </script>
    <script is:inline set:html={badgeHeadScript} />
  </head>
  <body>
    <a class="skip-link" href={`#${skipLink.target}`}>
      {skipLink.label}
    </a>
    <slot />
  </body>
</html>
