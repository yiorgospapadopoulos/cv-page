---
import { profile } from '../content/profile';
import { ownerName } from '../lib/site';

const { about } = profile;
---

<dialog id="more-dialog" class="dialog" aria-label={ownerName}>
  <div class="inner">
    <button type="button" class="close" aria-label="Close" data-dialog-close>
      <span aria-hidden="true">&times;</span>
    </button>
    {about.paragraphs.map((text) => (
      <p class="para">{text}</p>
    ))}
    <ul class="languages" aria-label="Languages">
      {about.languages.map((language) => (
        <li>{language}</li>
      ))}
    </ul>
  </div>
</dialog>

<script>
  import { bindDialog } from '../lib/dialog';

  const trigger = document.querySelector<HTMLElement>('[data-more-trigger]');
  const dialog = document.querySelector<HTMLDialogElement>('#more-dialog');
  if (trigger && dialog) bindDialog(trigger, dialog);
</script>

<style>
  .dialog {
    width: min(560px, calc(100% - 2 * var(--gutter)));
    max-height: min(86svh, 760px);
    padding: 0;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--paper);
    color: var(--ink);
    box-shadow: 0 30px 80px -20px rgb(17 17 17 / 0.4);
    overflow: auto;
  }

  .dialog[open] {
    animation: pop 0.2s ease-out;
  }

  .dialog::backdrop {
    background: rgb(17 17 17 / 0.35);
    backdrop-filter: blur(2px);
  }

  .inner {
    position: relative;
    padding: 40px 28px 32px;
  }

  .close {
    position: absolute;
    top: 10px;
    right: 12px;
    width: 36px;
    height: 36px;
    border: 0;
    border-radius: 50%;
    background: none;
    color: var(--ink-muted);
    font-size: 1.5rem;
    line-height: 1;
    cursor: pointer;
  }

  .close:hover {
    color: var(--ink);
    background: var(--soft);
  }

  .para {
    font-size: 1.125rem;
    line-height: 1.6;
  }

  .para + .para {
    margin-top: 1.1em;
  }

  .languages {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
    margin-top: 28px;
    padding-top: 20px;
    border-top: 1px solid var(--line);
    font-size: 0.95rem;
  }

  .languages li {
    font-weight: 500;
  }

  @keyframes pop {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
  }

  @media (min-width: 768px) {
    .inner {
      padding: 48px 44px 40px;
    }
  }
</style>
