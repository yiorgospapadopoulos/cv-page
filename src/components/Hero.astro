---
import { profile } from '../content/profile';
import { ownerName } from '../lib/site';
import { promptText } from '../lib/terminal';
import BadgePlaceholder from './BadgePlaceholder.astro';
import Badge from './badge/Badge';

const { hero } = profile;
const [firstName, ...rest] = ownerName.split(' ');
const lastName = rest.join(' ');
---

<header class="hero">
  <div class="top">
    <p class="intro">
      {hero.intro}{' '}
      <button
        type="button"
        class="more"
        aria-haspopup="dialog"
        data-more-trigger
      >
        {hero.moreLabel}
      </button>
    </p>
    <ul class="current">
      {hero.current.map((line) => {
        const [role, org] = line.split(' @ ');
        return (
          <li>
            {org === undefined ? (
              line
            ) : (
              <>
                <span>{role}</span> <span class="org">@ {org}</span>
              </>
            )}
          </li>
        );
      })}
    </ul>
  </div>

  <BadgePlaceholder>
    <Badge client:only="react" badge={profile.badge} prompt={promptText} />
  </BadgePlaceholder>

  <h1 class="name">
    <span>{firstName}</span> <span>{lastName}</span>
  </h1>
</header>

<style>
  .hero {
    --card-scale: 1.3;
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: 100svh;
    overflow: hidden;
    container-type: inline-size;
  }

  .top {
    position: relative;
    z-index: 3;
    display: flex;
    justify-content: space-between;
    gap: 24px;
    padding: 32px max(16px, 6vw) 0;
    font-size: 14px;
    line-height: 1.35;
  }

  .intro {
    max-width: 24ch;
  }

  .current {
    max-width: 48ch;
    text-align: right;
    text-wrap: balance;
  }

  .org {
    white-space: nowrap;
  }

  .more {
    padding: 0;
    border: 0;
    background: none;
    color: var(--ink-muted);
    font-size: inherit;
    cursor: pointer;
  }

  .more:hover {
    text-decoration: underline;
  }

  .name {
    position: relative;
    z-index: 1;
    padding-left: 1cqw;
    font-size: 19cqw;
    font-variation-settings: 'opsz' 144;
    font-weight: 450;
    line-height: 0.85;
    letter-spacing: -0.035em;
    white-space: nowrap;
  }

  .name span {
    display: block;
  }

  @media (min-width: 768px) {
    .top {
      font-size: 15px;
    }
  }

  @media (min-width: 860px) {
    .hero {
      min-height: max(100svh, calc(12px + 500px * var(--card-scale) + 16.5vw));
    }

    .top {
      padding: clamp(72px, 7vw, 96px) clamp(40px, 7vw, 120px) 0;
    }
  }

  @media (max-width: 479px) {
    .hero {
      --card-scale: 1.15;
    }
  }

  @media (min-width: 860px) and (max-height: 820px) {
    .hero {
      --card-scale: 1.15;
    }
  }

  @media (min-width: 860px) and (max-height: 780px) {
    .hero {
      --card-scale: 1;
    }
  }

  @media (min-width: 1280px) {
    .top {
      font-size: 16px;
    }
  }

  @media (max-width: 859px) {
    .top {
      flex-direction: column;
      justify-content: flex-start;
      gap: 10px;
    }

    .intro,
    .current {
      max-width: none;
      text-align: left;
    }
  }
</style>
