---
import { profile } from '../content/profile';

const { badge } = profile;
const nameLines = badge.name.split(' ');
const [roleHead, roleOrg] = badge.role.split(' @ ');
---

<div id="badge-slot" class="badge-slot" aria-hidden="true">
  <div class="badge" data-badge>
    <div class="strap">
      <span class="strap-text">{badge.strap}</span>
    </div>
    <div class="clip"></div>
    <div class="card">
      <p class="card-name">
        {nameLines.map((line) => (
          <span>{line}</span>
        ))}
      </p>
      <p class="card-role">
        {roleHead}
        {roleOrg !== undefined && ' '}
        {roleOrg !== undefined && <span class="nowrap">@ {roleOrg}</span>}
      </p>
      <p class="card-line">{badge.line}</p>
      <ul class="chips">
        {badge.chips.map((chip, i) => (
          <li class={`chip chip-${i % 3}`}>{chip}</li>
        ))}
      </ul>
      <p class="card-pass">{badge.pass}</p>
    </div>
  </div>
  <slot />
</div>

<style>
  .badge-slot {
    position: absolute;
    top: 0;
    left: 54%;
    z-index: 4;
    width: 0;
    pointer-events: none;
  }

  .badge {
    --strap-length: calc(168px * var(--card-scale));
    --u: calc(1px * var(--card-scale));
    position: absolute;
    top: 0;
    left: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    width: calc(220px * var(--card-scale));
    margin-left: calc(-110px * var(--card-scale));
    transform-origin: 50% 0;
    scale: 1;
    animation: sway 7s ease-in-out infinite alternate;
  }

  .badge-slot[data-badge-3d='ready'] .badge {
    opacity: 0;
    visibility: hidden;
    animation-play-state: paused;
    transition:
      opacity 500ms ease,
      visibility 0s linear 500ms;
  }

  .badge-slot :global(.badge-3d) {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 500ms ease;
  }

  .badge-slot :global(.badge-3d[data-ready]) {
    opacity: 1;
  }

  .badge-slot :global(.badge-frame) {
    position: absolute;
  }

  .badge-slot :global(.badge-frame canvas) {
    filter: drop-shadow(0 14px 18px rgb(17 17 17 / 0.16));
  }

  .badge-slot :global(.badge-hit) {
    position: absolute;
    top: 0;
    left: 0;
    pointer-events: auto;
    touch-action: none;
    user-select: none;
    -webkit-user-select: none;
    -webkit-tap-highlight-color: transparent;
  }

  .strap {
    display: flex;
    align-items: center;
    justify-content: center;
    width: calc(16px * var(--card-scale));
    height: var(--strap-length);
    background: var(--ink);
    overflow: hidden;
  }

  .strap-text {
    writing-mode: vertical-rl;
    color: var(--term-muted);
    font-family: var(--font-mono);
    font-size: calc(8px * var(--card-scale));
    letter-spacing: 0.04em;
    white-space: nowrap;
  }

  .clip {
    flex: none;
    width: calc(22px * var(--card-scale));
    height: calc(26px * var(--card-scale));
    border-radius: calc(3px * var(--card-scale)) calc(3px * var(--card-scale))
      calc(6px * var(--card-scale)) calc(6px * var(--card-scale));
    background: linear-gradient(90deg, #8a8a8a, #d6d6d6 45%, #7c7c7c);
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.25);
  }

  .card {
    flex: none;
    display: flex;
    flex-direction: column;
    width: calc(220 * var(--u));
    height: calc(310 * var(--u));
    margin-top: calc(-4 * var(--u));
    padding: calc(20 * var(--u)) calc(18 * var(--u)) calc(16 * var(--u));
    border: 1px solid var(--line);
    border-radius: calc(14 * var(--u));
    background: var(--paper);
    box-shadow:
      0 18px 40px -12px rgb(17 17 17 / 0.28),
      0 2px 6px rgb(17 17 17 / 0.08);
    rotate: 1.5deg;
    transform-origin: 50% 0;
  }

  .card-name {
    display: flex;
    flex-direction: column;
    font-size: calc(28 * var(--u));
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .card-role {
    margin-top: calc(18 * var(--u));
    font-size: calc(13 * var(--u));
    font-weight: 500;
    line-height: 1.25;
  }

  .nowrap {
    white-space: nowrap;
  }

  .card-line {
    margin-top: calc(4 * var(--u));
    color: var(--ink-muted);
    font-size: calc(12.8 * var(--u));
    line-height: 1.3;
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: calc(6 * var(--u));
    margin-top: calc(16 * var(--u));
  }

  .chip {
    padding: calc(2 * var(--u)) calc(9 * var(--u));
    border-radius: 999px;
    font-size: calc(11.52 * var(--u));
    line-height: 1.5;
  }

  .chip-0 {
    background: color-mix(in srgb, var(--link-linkedin) 14%, white);
    color: var(--link-linkedin);
  }

  .chip-1 {
    background: color-mix(in srgb, var(--link-email) 14%, white);
    color: #a63b08;
  }

  .chip-2 {
    background: color-mix(in srgb, var(--term-prompt) 30%, white);
    color: #1a6a2a;
  }

  .card-pass {
    margin-top: auto;
    align-self: flex-end;
    color: var(--ink-muted);
    font-family: var(--font-mono);
    font-size: calc(8.8 * var(--u));
    letter-spacing: 0.04em;
  }

  @keyframes sway {
    from {
      rotate: -2.5deg;
    }
    to {
      rotate: 2.5deg;
    }
  }

  @media (max-width: 859px) {
    .badge-slot {
      position: relative;
      left: auto;
      display: flex;
      flex: 1 1 0;
      justify-content: center;
      width: auto;
      /* Lets the card hang over most of the first name line when space is short. */
      min-height: calc(36px + 500px * var(--card-scale) - 13cqw);
      padding: 12px 0 24px;
    }

    .badge {
      position: relative;
      align-self: stretch;
      margin-left: 0;
    }

    .strap {
      flex: 1 1 0;
      min-height: var(--strap-length);
      max-height: 340px;
      height: auto;
    }
  }

  @media (hover: none) and (pointer: coarse) {
    .badge-slot {
      --w: min(80cqw, 380px, calc((100svh - 230px) / 1.6));
      position: relative;
      left: auto;
      display: flex;
      flex: 1 1 0;
      justify-content: center;
      width: auto;
      /* Lets the holder hang slightly over the first name line when space is short. */
      min-height: calc(var(--w) * 1.52 + 28px - 8cqw);
      padding: 28px 0 0;
    }

    .badge {
      --u: calc((var(--w) * 0.9 - 2px) / 220);
      position: relative;
      align-self: auto;
      width: var(--w);
      margin: auto 0;
      padding: calc(var(--w) * 0.2) calc(var(--w) * 0.05) calc(var(--w) * 0.05);
      border: 1px solid rgb(150 156 166 / 0.5);
      border-radius: calc(var(--w) * 0.07);
      background: linear-gradient(
        155deg,
        rgb(255 255 255 / 0.85),
        rgb(238 240 244 / 0.6) 55%,
        rgb(250 250 252 / 0.8)
      );
      box-shadow:
        inset 0 0 0 1.5px rgb(255 255 255 / 0.95),
        inset 0 0 0 2.5px rgb(185 190 200 / 0.22),
        calc(var(--w) * 0.05) calc(var(--w) * 0.08) calc(var(--w) * 0.07)
          calc(var(--w) * -0.015) rgb(17 17 17 / 0.2),
        calc(var(--w) * 0.012) calc(var(--w) * 0.02) calc(var(--w) * 0.02)
          rgb(17 17 17 / 0.06);
      transform: rotate(7deg);
      transform-origin: 50% 50%;
      animation: none;
    }

    .badge::before {
      content: '';
      position: absolute;
      top: calc(var(--w) * 0.06);
      left: 50%;
      width: calc(var(--w) * 0.22);
      height: calc(var(--w) * 0.05);
      margin-left: calc(var(--w) * -0.11);
      border: 1px solid rgb(150 156 166 / 0.75);
      border-radius: 999px;
      background: rgb(255 255 255 / 0.95);
      box-shadow: inset 0 1px 1.5px rgb(17 17 17 / 0.12);
    }

    .badge::after {
      --ring: calc(var(--w) * 0.032);
      content: '';
      position: absolute;
      top: 0;
      right: calc(var(--w) * 0.03);
      left: calc(var(--w) * 0.03);
      height: calc(var(--w) * 0.2);
      background:
        radial-gradient(
          circle at 16% 38%,
          rgb(255 255 255 / 0.95) var(--ring),
          rgb(150 156 166 / 0.8) calc(var(--ring) + 1px),
          transparent calc(var(--ring) + 1.5px)
        ),
        radial-gradient(
          circle at 84% 38%,
          rgb(255 255 255 / 0.95) var(--ring),
          rgb(150 156 166 / 0.8) calc(var(--ring) + 1px),
          transparent calc(var(--ring) + 1.5px)
        ),
        linear-gradient(rgb(255 255 255 / 0.95), rgb(255 255 255 / 0.95)) 0
          calc(var(--w) * 0.168) / 100% 1.5px no-repeat,
        linear-gradient(rgb(165 171 182 / 0.55), rgb(165 171 182 / 0.55)) 0
          calc(var(--w) * 0.18) / 100% 1px no-repeat,
        linear-gradient(rgb(165 171 182 / 0.4), rgb(165 171 182 / 0.4)) 0
          calc(var(--w) * 0.19) / 100% 1px no-repeat;
    }

    .strap,
    .clip {
      display: none;
    }

    .card {
      margin-top: 0;
      border-radius: calc(8 * var(--u));
      background: #fbfbfa;
      box-shadow: 0 1px 2px rgb(17 17 17 / 0.12);
      rotate: none;
    }
  }
</style>
