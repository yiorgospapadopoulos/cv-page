---
import { profile } from '../content/profile';

const { badge } = profile;
const nameLines = badge.name.split(' ');
---

<div id="badge-slot" class="badge-slot" aria-hidden="true">
  <div class="badge" data-badge>
    <div class="strap">
      <span class="strap-text">{badge.strap}</span>
    </div>
    <div class="clip"></div>
    <div class="card">
      <p class="card-name">
        {nameLines.map((line) => (
          <span>{line}</span>
        ))}
      </p>
      <p class="card-role">{badge.role}</p>
      <p class="card-line">{badge.line}</p>
      <ul class="chips">
        {badge.chips.map((chip, i) => (
          <li class={`chip chip-${i % 3}`}>{chip}</li>
        ))}
      </ul>
      <p class="card-pass">{badge.pass}</p>
    </div>
  </div>
</div>

<style>
  .badge-slot {
    position: absolute;
    top: 0;
    left: 54%;
    z-index: 2;
    width: 0;
    pointer-events: none;
  }

  .badge {
    --strap-length: 170px;
    position: absolute;
    top: 0;
    left: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 220px;
    margin-left: -110px;
    transform-origin: 50% 0;
    scale: 1;
    animation: sway 7s ease-in-out infinite alternate;
  }

  .strap {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 16px;
    height: var(--strap-length);
    background: var(--ink);
    overflow: hidden;
  }

  .strap-text {
    writing-mode: vertical-rl;
    color: var(--term-muted);
    font-family: var(--font-mono);
    font-size: 8px;
    letter-spacing: 0.04em;
    white-space: nowrap;
  }

  .clip {
    width: 22px;
    height: 26px;
    border-radius: 3px 3px 6px 6px;
    background: linear-gradient(90deg, #8a8a8a, #d6d6d6 45%, #7c7c7c);
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.25);
  }

  .card {
    display: flex;
    flex-direction: column;
    width: 220px;
    height: 310px;
    margin-top: -4px;
    padding: 20px 18px 16px;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: var(--paper);
    box-shadow:
      0 18px 40px -12px rgb(17 17 17 / 0.28),
      0 2px 6px rgb(17 17 17 / 0.08);
    rotate: 1.5deg;
    transform-origin: 50% 0;
  }

  .card-name {
    display: flex;
    flex-direction: column;
    font-size: 1.75rem;
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .card-role {
    margin-top: 18px;
    font-size: 0.9rem;
    font-weight: 500;
    line-height: 1.25;
  }

  .card-line {
    margin-top: 4px;
    color: var(--ink-muted);
    font-size: 0.8rem;
    line-height: 1.3;
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 16px;
  }

  .chip {
    padding: 2px 9px;
    border-radius: 999px;
    font-size: 0.72rem;
    line-height: 1.5;
  }

  .chip-0 {
    background: color-mix(in srgb, var(--link-linkedin) 14%, white);
    color: var(--link-linkedin);
  }

  .chip-1 {
    background: color-mix(in srgb, var(--link-email) 14%, white);
    color: #b8430a;
  }

  .chip-2 {
    background: color-mix(in srgb, var(--term-prompt) 30%, white);
    color: #1a6a2a;
  }

  .card-pass {
    margin-top: auto;
    align-self: flex-end;
    color: var(--ink-muted);
    font-family: var(--font-mono);
    font-size: 0.55rem;
    letter-spacing: 0.04em;
  }

  @keyframes sway {
    from {
      rotate: -2.5deg;
    }
    to {
      rotate: 2.5deg;
    }
  }

  @media (max-width: 767px) {
    .badge {
      scale: 0.82;
    }
  }
</style>
