---
import { profile } from '../content/profile';

const { badge } = profile;
const nameLines = badge.name.split(' ');
const [roleHead, roleOrg] = badge.role.split(' @ ');
---

<div id="badge-slot" class="badge-slot" aria-hidden="true">
  <div class="badge" data-badge>
    <div class="strap">
      <span class="strap-text">{badge.strap}</span>
    </div>
    <div class="clip"></div>
    <div class="card">
      <p class="card-name">
        {nameLines.map((line) => (
          <span>{line}</span>
        ))}
      </p>
      <p class="card-role">
        {roleHead}
        {roleOrg !== undefined && ' '}
        {roleOrg !== undefined && <span class="nowrap">@ {roleOrg}</span>}
      </p>
      <p class="card-line">{badge.line}</p>
      <ul class="chips">
        {badge.chips.map((chip, i) => (
          <li class={`chip chip-${i % 3}`}>{chip}</li>
        ))}
      </ul>
      <p class="card-pass">{badge.pass}</p>
    </div>
  </div>
  <slot />
</div>

<style>
  .badge-slot {
    position: absolute;
    top: 0;
    left: 54%;
    z-index: 4;
    width: 0;
    pointer-events: none;
  }

  .badge {
    --strap-length: 130px;
    position: absolute;
    top: 0;
    left: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    width: calc(220px * var(--card-scale));
    margin-left: calc(-110px * var(--card-scale));
    transform-origin: 50% 0;
    scale: 1;
    animation: sway 7s ease-in-out infinite alternate;
  }

  .badge-slot[data-badge-3d='ready'] .badge {
    opacity: 0;
    visibility: hidden;
    animation-play-state: paused;
    transition:
      opacity 500ms ease,
      visibility 0s linear 500ms;
  }

  .badge-slot :global(.badge-3d) {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 500ms ease;
  }

  .badge-slot :global(.badge-3d[data-ready]) {
    opacity: 1;
  }

  .badge-slot :global(.badge-frame) {
    position: absolute;
  }

  .badge-slot :global(.badge-frame canvas) {
    filter: drop-shadow(0 14px 18px rgb(17 17 17 / 0.16));
  }

  .badge-slot :global(.badge-hit) {
    position: absolute;
    top: 0;
    left: 0;
    pointer-events: auto;
    touch-action: none;
    user-select: none;
    -webkit-user-select: none;
    -webkit-tap-highlight-color: transparent;
  }

  .strap {
    display: flex;
    align-items: center;
    justify-content: center;
    width: calc(16px * var(--card-scale));
    height: var(--strap-length);
    background: var(--ink);
    overflow: hidden;
  }

  .strap-text {
    writing-mode: vertical-rl;
    color: var(--term-muted);
    font-family: var(--font-mono);
    font-size: calc(8px * var(--card-scale));
    letter-spacing: 0.04em;
    white-space: nowrap;
  }

  .clip {
    flex: none;
    width: calc(22px * var(--card-scale));
    height: calc(26px * var(--card-scale));
    border-radius: calc(3px * var(--card-scale)) calc(3px * var(--card-scale))
      calc(6px * var(--card-scale)) calc(6px * var(--card-scale));
    background: linear-gradient(90deg, #8a8a8a, #d6d6d6 45%, #7c7c7c);
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.25);
  }

  .card {
    flex: none;
    display: flex;
    flex-direction: column;
    width: calc(220px * var(--card-scale));
    height: calc(310px * var(--card-scale));
    margin-top: calc(-4px * var(--card-scale));
    padding: calc(20px * var(--card-scale)) calc(18px * var(--card-scale))
      calc(16px * var(--card-scale));
    border: 1px solid var(--line);
    border-radius: calc(14px * var(--card-scale));
    background: var(--paper);
    box-shadow:
      0 18px 40px -12px rgb(17 17 17 / 0.28),
      0 2px 6px rgb(17 17 17 / 0.08);
    rotate: 1.5deg;
    transform-origin: 50% 0;
  }

  .card-name {
    display: flex;
    flex-direction: column;
    font-size: calc(28px * var(--card-scale));
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .card-role {
    margin-top: calc(18px * var(--card-scale));
    font-size: calc(13px * var(--card-scale));
    font-weight: 500;
    line-height: 1.25;
  }

  .nowrap {
    white-space: nowrap;
  }

  .card-line {
    margin-top: calc(4px * var(--card-scale));
    color: var(--ink-muted);
    font-size: calc(12.8px * var(--card-scale));
    line-height: 1.3;
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: calc(6px * var(--card-scale));
    margin-top: calc(16px * var(--card-scale));
  }

  .chip {
    padding: calc(2px * var(--card-scale)) calc(9px * var(--card-scale));
    border-radius: 999px;
    font-size: calc(11.52px * var(--card-scale));
    line-height: 1.5;
  }

  .chip-0 {
    background: color-mix(in srgb, var(--link-linkedin) 14%, white);
    color: var(--link-linkedin);
  }

  .chip-1 {
    background: color-mix(in srgb, var(--link-email) 14%, white);
    color: #a63b08;
  }

  .chip-2 {
    background: color-mix(in srgb, var(--term-prompt) 30%, white);
    color: #1a6a2a;
  }

  .card-pass {
    margin-top: auto;
    align-self: flex-end;
    color: var(--ink-muted);
    font-family: var(--font-mono);
    font-size: calc(8.8px * var(--card-scale));
    letter-spacing: 0.04em;
  }

  @keyframes sway {
    from {
      rotate: -2.5deg;
    }
    to {
      rotate: 2.5deg;
    }
  }

  @media (max-width: 859px) {
    .badge-slot {
      position: relative;
      left: auto;
      display: flex;
      flex: 1 1 auto;
      justify-content: center;
      width: auto;
      min-height: calc(76px + 332px * var(--card-scale));
      padding: 12px 0 24px;
    }

    .badge {
      position: relative;
      align-self: stretch;
      margin-left: 0;
    }

    .strap {
      flex: 1 1 0;
      min-height: 40px;
      max-height: 300px;
      height: auto;
    }
  }
</style>
