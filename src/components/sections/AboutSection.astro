---
import { profile } from '../../content/profile';
import { terminalSections } from '../../lib/terminal';
import TerminalCommand from '../terminal/TerminalCommand.astro';
import TerminalPart from '../terminal/TerminalPart.astro';

const { about } = profile;
const [section] = terminalSections;
---

<TerminalPart id={section.id} heading={section.heading}>
  <TerminalCommand command={section.command}>
    <dl class="facts">
      {about.facts.map((fact) => (
        <div class="fact">
          <dt>{fact.key}:</dt>
          <dd>{fact.value}</dd>
        </div>
      ))}
    </dl>
  </TerminalCommand>
</TerminalPart>

<style>
  .facts {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: 0.15em 2ch;
    margin: 0;
  }

  .fact {
    display: contents;
  }

  dt {
    color: var(--term-accent);
  }

  dd {
    margin: 0;
    color: var(--term-bright);
  }

  @media (max-width: 480px) {
    .facts {
      grid-template-columns: 1fr;
      gap: 0;
    }

    dd {
      margin-bottom: 0.4em;
    }
  }
</style>
