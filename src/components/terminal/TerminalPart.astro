---
import TerminalWindow from './TerminalWindow.astro';

interface Props {
  id: string;
  heading: string;
}

const { id, heading } = Astro.props;
---

<section id={id} class="part" aria-labelledby={`${id}-heading`}>
  <h2 id={`${id}-heading`}>{heading}</h2>
  <TerminalWindow>
    <slot />
  </TerminalWindow>
</section>

<style>
  .part {
    scroll-margin-top: 24px;
  }

  h2 {
    margin-bottom: 14px;
    font-size: 28px;
    font-variation-settings: 'opsz' 72;
    font-weight: 450;
    line-height: 1.1;
    letter-spacing: -0.015em;
  }

  @media (min-width: 768px) {
    h2 {
      font-size: 34px;
    }
  }
</style>
