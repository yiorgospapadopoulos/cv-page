---
import { profile } from '../content/profile';
import { footerParts } from '../lib/footer';

const { footer } = profile;
const parts = footerParts(profile);
---

<footer class="footer">
  <div class="inner">
    <h2 class="closing">{footer.closing}</h2>
    <p class="text">
      {parts.map((part) =>
        part.kind === 'text' ? (
          part.text
        ) : (
          <a
            class={`pill ${part.link}`}
            href={part.href}
            target={part.external ? '_blank' : undefined}
            rel={part.external ? 'noopener noreferrer' : undefined}
          >
            {part.label}
          </a>
        ),
      )}
    </p>
    <a class="cv" href={profile.footer.cvPath} download>
      <span>{footer.cvLabel}</span>
      <svg
        class="arrow"
        viewBox="0 0 16 16"
        width="14"
        height="14"
        aria-hidden="true"
        focusable="false"
      >
        <path
          d="M8 2.5v9m0 0L4.5 8M8 11.5 11.5 8M3 14h10"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
          stroke-linejoin="round"
        ></path>
      </svg>
    </a>
    <div class="base">
      <p>{footer.copyright}</p>
      <p>{footer.builtWith}</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    padding: clamp(72px, 11vw, 144px) 0 32px;
    background: var(--paper);
  }

  .inner {
    max-width: calc(1040px + 2 * var(--gutter));
    margin: 0 auto;
    padding: 0 var(--gutter);
  }

  .closing {
    max-width: 14ch;
    font-size: 34px;
    font-variation-settings: 'opsz' 144;
    font-weight: 400;
    line-height: 1.05;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  .text {
    max-width: 36em;
    margin-top: 28px;
    font-size: 19px;
    line-height: 2;
  }

  .pill {
    display: inline-block;
    padding: 0 0.7em;
    border-radius: 999px;
    color: #fff;
    font-size: 0.88em;
    font-weight: 500;
    line-height: 1.7;
    text-decoration: none;
    transition:
      transform 140ms ease,
      box-shadow 140ms ease;
  }

  .pill:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 14px -6px rgb(0 0 0 / 0.45);
  }

  .linkedin {
    background: var(--link-linkedin);
  }

  .github {
    background: var(--link-github);
  }

  .email {
    background: var(--link-email);
  }

  .cv {
    display: inline-flex;
    align-items: center;
    gap: 0.6em;
    margin-top: 28px;
    padding: 9px 18px;
    border: 1px solid var(--ink);
    border-radius: 999px;
    font-size: 16px;
    line-height: 1.3;
    text-decoration: none;
    transition:
      background-color 140ms ease,
      color 140ms ease;
  }

  .cv:hover {
    background: var(--ink);
    color: var(--paper);
  }

  .base {
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin-top: clamp(56px, 9vw, 112px);
    padding-top: 20px;
    border-top: 1px solid var(--line);
    color: var(--ink-muted);
    font-size: 14px;
  }

  @media (min-width: 768px) {
    .closing {
      font-size: clamp(44px, 5.6vw, 64px);
    }

    .text {
      font-size: 22px;
    }

    .base {
      flex-direction: row;
      justify-content: space-between;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pill:hover {
      transform: none;
    }
  }
</style>
